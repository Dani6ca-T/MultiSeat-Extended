{
  "MultiSeat": {
    "MaxSeats": 4,
    "PortBase": 48100,
    "ApolloExePath": "C:\\Program Files\\ApolloVibe\\sunshine.exe",
    "ApolloConfigDir": "C:\\ProgramData\\MultiSeat\\apollo",
    "NvencPreset": 4,
    "ApiPort": 9550,
    "ApiKey": "",
    "RequireHttps": false,
    "CorsOrigins": [],
    "AudioMode": "SharedHost",
    "VacCableCount": 4,
    "HidHideCliPath": "C:\\Program Files\\Nefarius Software Solutions\\HidHide\\x64\\HidHideCLI.exe",
    "InputHookDllPath": "MultiSeatInputHook.dll",
    "EnableKeyboardMouseIsolation": false,
    "AutoAssignControllers": true,
    "SessionConnectTimeoutMs": 15000,
    "ProcessLaunchTimeoutMs": 10000,
    "HealthCheckIntervalMs": 5000,
    "LaunchOnConnectDelayMs": 4000,
    "KillLaunchOnConnectAppsOnDisconnect": false,
    "LaunchOnConnect": [],
    "EnableSharedGameLibrary": true,
    "SharedGameLibraryDir": "C:\\MultiSeatGames",
    "EnableEmulatorNetplay": true,
    "SeedRetroArchNetplayConfig": false,
    "RetroArchConfigPath": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "MultiSeat.Service": "Debug"
    },

    // The service runs under AddWindowsService(), whose only logging destination is the
    // Windows Event Log — and which installs a provider-specific rule filtering the
    // EventLog provider to Warning and above. Provider-specific rules outrank every
    // category rule in "LogLevel" above (those apply to any provider), so without this
    // section EVERY LogInformation and LogDebug in the service is silently discarded:
    // 300 events sampled on the reference host were 275 Warning + 25 Error, zero
    // Information. That hid our own diagnostics from us and from bug reporters.
    //
    // Rules here are provider-specific too, and are added after the one AddWindowsService
    // installs, so at equal specificity they win. Keep "Default" at Warning: raising it
    // would also outrank the "Microsoft": "Warning" rule above and push every ASP.NET Core
    // request log into a machine-wide log.
    "EventLog": {
      "LogLevel": {
        "Default": "Warning",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "MultiSeat.Service": "Information"
      }
    }
  }
}
